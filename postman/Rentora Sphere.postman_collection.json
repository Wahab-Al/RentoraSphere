        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// save the token as variable in postman, that automatically updated when you login:\r",
                  "\r",
                  "const responseData = pm.response.json();\r",
                  "if (responseData.token) {\r",
                  "    pm.environment.set(\"token\", responseData.token);\r",
                  "    console.log(\"Token updated in environment variables!\");\r",
                  "\r",
                  "\r",
                  "    if (responseData.user && responseData.user.id) {\r",
                  "        pm.environment.set(\"userId\", responseData.user.id);\r",
                  "        console.log(\"User ID updated!\");\r",
                  "    }\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
